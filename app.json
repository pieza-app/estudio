{
 "nombre": "Pieza",
 "id": "pieza",
 "version": "0.2.0",
 "repo": "pieza-app/estudio",
 "datos": "sistema",
 "icono": "docs/favicon.svg",
 "plataformas": [
  "mac",
  "windows",
  "linux"
 ],
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "tema": [
   "sistema",
   "claro",
   "oscuro"
  ]
 },
 "empaquetado": {
  "descripcion": "Crea apps paso a paso con piezas ya hechas y la IA de la persona.",
  "categoria": "public.app-category.developer-tools",
  "linux_categoria": "Development",
  "carpetas": [
   "datos"
  ],
  "permisos": [],
  "ocupada": [],
  "quitar": [
   "ui/demo-catalogo.json"
  ]
 },
 "acciones": {
  "piezasLista": {
   "script": "piezas.py",
   "args": [
    "lista"
   ],
   "entrada": null,
   "datos": {},
   "responde": "piezasListas",
   "limite": 30
  },
  "piezasFicha": {
   "script": "piezas.py",
   "args": [
    "ficha"
   ],
   "entrada": "archivo",
   "datos": {
    "plataformas": {
     "tipo": "lista",
     "max": 6,
     "requerido": true
    },
    "piezas": {
     "tipo": "lista",
     "max": 60
    }
   },
   "responde": "fichaLista",
   "limite": 30
  },
  "proyectosLista": {
   "script": "proyectos.py",
   "args": [
    "lista"
   ],
   "entrada": null,
   "datos": {},
   "responde": "proyectosListos",
   "limite": 30
  },
  "proyectoPlan": {
   "script": "proyectos.py",
   "args": [
    "plan"
   ],
   "entrada": "archivo",
   "datos": {
    "nombre": {
     "tipo": "texto",
     "max": 40,
     "requerido": true
    },
    "frase": {
     "tipo": "texto",
     "max": 300,
     "requerido": true
    },
    "plataformas": {
     "tipo": "lista",
     "max": 6,
     "requerido": true
    },
    "piezas": {
     "tipo": "lista",
     "max": 60
    }
   },
   "responde": "planListo",
   "limite": 660
  },
  "proyectoCrear": {
   "script": "proyectos.py",
   "args": [
    "crear"
   ],
   "entrada": "archivo",
   "datos": {
    "id": {
     "tipo": "texto",
     "max": 30,
     "requerido": true
    }
   },
   "responde": "proyectoCreado",
   "limite": 330
  },
  "proyectoPaso": {
   "script": "proyectos.py",
   "args": [
    "paso"
   ],
   "entrada": "archivo",
   "datos": {
    "id": {
     "tipo": "texto",
     "max": 30,
     "requerido": true
    },
    "n": {
     "tipo": "entero",
     "min": 0,
     "max": 11,
     "requerido": true
    }
   },
   "responde": "pasoListo",
   "limite": 2400
  }
 }
}
